# ============================================================
# EasyHome web app - environment
# Copy to `.env.local` and fill in the API + Google settings.
# ============================================================

# Base URL of the EasyHome API, including the /api suffix.
# Local dev can use /api because Vite proxies it to localhost:5000.
# Production must point at the deployed Vercel API, including /api.
VITE_API_URL=/api

# Google Cloud OAuth 2.0 Web client ID. Used by the native Google
# account chooser on the sign-in page.
VITE_GOOGLE_CLIENT_ID=

# Optional: public site URL used in share links (no trailing slash)
VITE_APP_URL=https://easyhome-front.vercel.app
