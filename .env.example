# ============================================================
# EasyHome web app - environment
# Copy to `.env.local` and fill in your Firebase web app config.
# Firebase Console -> Project settings -> Your apps -> Web app -> Config
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the EasyHome API, including the /api suffix.
# Local dev can use /api because Vite proxies it to localhost:5000.
# Production must point at the deployed API (for example
# https://easyhome-api.onrender.com/api); Firebase Hosting does not run Express.
VITE_API_URL=/api

# Optional: public site URL used in share links (no trailing slash)
VITE_APP_URL=https://easyhome-bec14.web.app
