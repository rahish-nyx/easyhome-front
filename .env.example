# ============================================================
# EasyHome web app - environment
# Copy to `.env.local` and fill in your Firebase web app config.
# Firebase Console -> Project settings -> Your apps -> Web app -> Config
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Base URL of the EasyHome API. Leave as /api when using the Vite proxy
# locally or when the API is on the same domain.
VITE_API_URL=/api

# Optional: public site URL used in share links (no trailing slash)
VITE_APP_URL=https://easyhome-bec14.web.app
